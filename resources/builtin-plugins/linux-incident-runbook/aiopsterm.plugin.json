{
  "id": "aiopsterm.operations-toolkit",
  "displayName": "Operations Toolkit",
  "version": "0.1.0",
  "description": "提供可扩展的 Linux 运维检查树和终端操作。",
  "engines": {
    "aiopsterm": ">=0.1.0"
  },
  "main": "main.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "required": false,
  "iconKey": "runbook",
  "categories": [
    "Operations",
    "Runbook"
  ],
  "readme": "Operations Toolkit 使用可执行插件 SDK 注册动态树、命令、上下文、状态和版本信息。选择检查项后，命令会通过宿主发送到当前终端。",
  "functions": [
    {
      "title": "动态运维检查树",
      "desc": "由插件运行时提供 Linux 系统、服务、网络和日志检查项。"
    },
    {
      "title": "状态与上下文",
      "desc": "记录使用次数并通过上下文控制视图菜单。"
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "aiopsterm.operations-toolkit.run",
        "title": "运行检查",
        "description": "把选中的运维检查命令发送到当前终端。"
      },
      {
        "id": "aiopsterm.operations-toolkit.refresh",
        "title": "刷新检查项",
        "description": "刷新 Operations Toolkit 树。"
      }
    ],
    "views": [
      {
        "id": "aiopsterm.operations-toolkit.checks",
        "name": "运维检查",
        "location": "extensions"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aiopsterm.operations-toolkit.refresh",
          "when": "view == aiopsterm.operations-toolkit.checks",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "aiopsterm.operations-toolkit.run",
          "when": "viewItem == runnable",
          "group": "inline"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aiopsterm.operations-toolkit.checks",
        "content": "选择检查项后会将只读诊断命令发送到当前终端。",
        "when": "aiopsterm.operations-toolkit.ready"
      }
    ]
  }
}
