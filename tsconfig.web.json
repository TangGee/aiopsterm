{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "vitest/globals"
    ]
  },
  "include": [
    "src/shared/**/*.ts",
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.vue",
    "src/renderer/src/**/*.d.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "tests/regression/**/*.test.ts",
    "tests/cline-agent-sidecar-runtime.test.ts",
    "tests/local-editor-files-backend.test.ts",
    "tests/files-cross-host-transfer-runtime.test.ts",
    "tests/files-resumable-transfer.test.ts",
    "tests/im-gateway-core-backend.test.ts",
    "tests/im-gateway-input-backend.test.ts",
    "tests/im-gateway-output-backend.test.ts",
    "tests/im-gateway-ipc.test.ts",
    "tests/im-gateway-manager-backend.test.ts",
    "tests/im-gateway-feishu-backend.test.ts",
    "tests/im-gateway-telegram-backend.test.ts",
    "tests/im-gateway-infoflow-backend.test.ts",
    "tests/im-gateway-platforms-backend.test.ts",
    "tests/im-gateway-terminal-backend.test.ts",
    "tests/files-transfer-endpoint.test.ts",
    "tests/ssh-terminal-recovery-backend.test.ts",
    "tests/ssh-terminal-relay-shell-backend.test.ts",
    "tests/ssh-terminal-recovery-integration-backend.test.ts",
    "tests/terminal-recovery-store-backend.test.ts",
    "tests/global-voice-service-backend.test.ts",
    "tests/voice-engine-server-backend.test.ts",
    "tests/voice-model-installer-backend.test.ts",
    "tests/voice-archive-extraction-backend.test.ts",
    "tests/voice-install-diagnostics-backend.test.ts",
    "tests/zipformer-pipeline-backend.test.ts"
  ]
}
