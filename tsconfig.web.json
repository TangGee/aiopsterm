{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals"]
  },
  "include": [
    "src/shared/**/*.ts",
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.vue",
    "src/renderer/src/**/*.d.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "tests/cline-agent-sidecar-runtime.test.ts",
    "tests/local-editor-files-backend.test.ts"
  ]
}
