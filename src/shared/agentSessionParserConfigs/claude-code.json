{
  "schemaVersion": 1,
  "id": "claude-code",
  "source": "claude-code",
  "displayName": "Claude Code",
  "storage": {
    "kind": "jsonl",
    "paths": ["${HOME}/.claude/projects/**/*.jsonl"]
  },
  "rules": [
    {
      "id": "plain-message",
      "match": { "/type": ["user", "assistant"] },
      "kind": "message",
      "rolePointer": "/message/role",
      "contentPointers": ["/message/content"]
    },
    {
      "id": "text-block",
      "scopePointer": "/message/content/*",
      "match": { "/type": "text" },
      "kind": "message",
      "rolePointer": "$/message/role",
      "contentPointers": ["/text"]
    },
    {
      "id": "thinking-block",
      "scopePointer": "/message/content/*",
      "match": { "/type": "thinking" },
      "kind": "reasoning",
      "role": "assistant",
      "contentPointers": ["/thinking"]
    },
    {
      "id": "tool-use-block",
      "scopePointer": "/message/content/*",
      "match": { "/type": ["tool_use", "server_tool_use"] },
      "kind": "tool call",
      "role": "tool",
      "contentPointers": ["/input"],
      "labelPointer": "/name"
    },
    {
      "id": "tool-result-block",
      "scopePointer": "/message/content/*",
      "match": { "/type": "tool_result" },
      "kind": "tool result",
      "role": "tool",
      "contentPointers": ["/content/*/text", "/content"]
    },
    {
      "id": "agent-result",
      "match": { "/type": "result" },
      "kind": "result",
      "role": "assistant",
      "contentPointers": ["/result"]
    },
    {
      "id": "queued-user-message",
      "match": { "/type": "queue-operation", "/operation": "enqueue" },
      "kind": "message",
      "role": "user",
      "contentPointers": ["/content"]
    },
    {
      "id": "last-prompt-snapshot",
      "match": { "/type": "last-prompt" },
      "kind": "message snapshot",
      "role": "user",
      "contentPointers": ["/lastPrompt"]
    },
    {
      "id": "queued-command",
      "match": { "/type": "attachment", "/attachment/type": "queued_command" },
      "kind": "message",
      "role": "user",
      "contentPointers": ["/attachment/prompt"]
    },
    {
      "id": "system-content",
      "match": { "/type": "system", "/subtype": ["away_summary", "local_command", "compact_boundary"] },
      "kind": "system message",
      "role": "system",
      "contentPointers": ["/content"]
    },
    {
      "id": "stop-hook-errors",
      "match": { "/type": "system", "/subtype": "stop_hook_summary" },
      "kind": "system message",
      "role": "system",
      "contentPointers": ["/hookErrors", "/hookAdditionalContext"]
    },
    {
      "id": "hook-result",
      "match": { "/type": "attachment", "/attachment/type": "hook_success" },
      "kind": "tool result",
      "role": "tool",
      "contentPointers": ["/attachment/stdout", "/attachment/stderr"],
      "labelPointer": "/attachment/hookName"
    },
    {
      "id": "hook-blocking-error",
      "match": { "/type": "attachment", "/attachment/type": "hook_blocking_error" },
      "kind": "tool result",
      "role": "tool",
      "contentPointers": ["/attachment/blockingError"],
      "labelPointer": "/attachment/hookName"
    },
    {
      "id": "task-reminder",
      "match": { "/type": "attachment", "/attachment/type": "task_reminder" },
      "kind": "system context",
      "role": "system",
      "contentPointers": ["/attachment/content"]
    },
    {
      "id": "skill-listing",
      "match": { "/type": "attachment", "/attachment/type": "skill_listing" },
      "kind": "system context",
      "role": "system",
      "contentPointers": ["/attachment/content"]
    },
    {
      "id": "edited-file",
      "match": { "/type": "attachment", "/attachment/type": "edited_text_file" },
      "kind": "tool result",
      "role": "tool",
      "contentPointers": ["/attachment/snippet"],
      "labelPointer": "/attachment/filename"
    },
    {
      "id": "plan-file",
      "match": { "/type": "attachment", "/attachment/type": "plan_file_reference" },
      "kind": "system context",
      "role": "system",
      "contentPointers": ["/attachment/planContent"],
      "labelPointer": "/attachment/planFilePath"
    },
    {
      "id": "attached-file",
      "match": { "/type": "attachment", "/attachment/type": "file" },
      "kind": "attachment",
      "role": "user",
      "contentPointers": ["/attachment/content/file/content"],
      "labelPointer": "/attachment/filename"
    }
  ],
  "fallback": "raw-json"
}
