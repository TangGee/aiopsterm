{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@shared/*": ["src/shared/*"], "@/*": ["src/renderer/src/*"] }
  },
  "include": ["tests/regression/**/*.ts", "tests/installed-e2e/**/*.ts", "playwright.install.config.ts", "playwright.regression.config.ts", "playwright.stress.config.ts", "vitest.workspace.ts"]
}
